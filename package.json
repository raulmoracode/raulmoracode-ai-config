{
  "name": "@raulmoracode/ai-config",
  "version": "0.0.0",
  "private": true,
  "description": "Configure OpenCode to consume a centralized library of remotely hosted skills",
  "license": "MIT",
  "author": "Raúl Mora (raulmoracode)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulmoracode/raulmoracode-ai-config.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "raulmoracode-ai-config": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "opencode",
    "skills",
    "cli",
    "ai-agents"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
